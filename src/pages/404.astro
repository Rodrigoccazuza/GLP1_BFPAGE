---
import Layout from '../layouts/Layout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';

const landingPage = import.meta.env.BASE_URL;
const bodyFactoryHome = 'https://www.bodyfactoryskincare.com/';
---

<Layout title="Page not found | BodyFactory" description="The page you requested could not be found." robots="noindex,nofollow">
  <main class="not-found" id="main">
    <div class="not-found-inner">
      <img src="assets/logo-white.png" alt="BodyFactory Skin Care" width="540" height="165"/>
      <span class="not-found-code">ERROR 404</span>
      <h1>This page stepped out.</h1>
      <p>The link may have changed, but your next step is still close. Return to the GLP-1 experience or visit the main BodyFactory website.</p>
      <div class="not-found-actions">
        <a class="pill primary" href={landingPage}>Back to GLP-1 page <ArrowIcon/></a>
        <a class="pill outline" href={bodyFactoryHome}>BodyFactory home <ArrowIcon/></a>
      </div>
      <p class="not-found-copy">© {new Date().getFullYear()} BodyFactory Skin Care. All rights reserved.</p>
    </div>
  </main>
</Layout>
