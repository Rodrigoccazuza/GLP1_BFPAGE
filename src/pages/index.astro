---
import Layout from '../layouts/Layout.astro';
import Dialogs from '../components/Dialogs.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { program, why, plans, inclusions, journey, care, benefits, faqs, locations, disclosure } from '../content';

const nav = [['#how', 'How it works'], ['#plans', 'Plans'], ['#care', 'Your care'], ['#faq', 'FAQ'], ['#locations', 'Locations']];
---

<Layout>
  <header class="site-header" id="top">
    <div class="container nav-row">
      <a class="brand" href={program.home} aria-label="BodyFactory Skin Care home"><img src="assets/figma/logo.png" alt="BodyFactory Skin Care" width="143" height="66" /></a>
      <nav class="desktop-nav" aria-label="Main navigation">{nav.map(([href, label]) => <a href={href}>{label}</a>)}</nav>
      <button class="pill primary nav-book" type="button" data-action="book">Book consultation</button>
      <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button>
    </div>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" hidden>
      {nav.map(([href, label]) => <a href={href}>{label}</a>)}
      <a href={program.home}>BodyFactory home</a>
      <button class="pill primary" type="button" data-action="book">Book consultation</button>
    </nav>
  </header>

  <main id="main">
    <section class="hero container" aria-labelledby="hero-title" data-hero-section>
      <div class="hero-copy" data-hero>
        <p class="eyebrow">Compounded GLP-1 &amp; GIP in New York</p>
        <h1 id="hero-title" class="t-display">Weight loss, <em>personalized.</em></h1>
        <p class="hero-sub t-lead">A program medically supervised by an NP, designed to help you eat less, feel fuller, and work toward sustainable, long-term results.</p>
        <div class="hero-actions">
          <button class="pill primary hero-primary" type="button" data-action="book">Schedule your consultation <ArrowIcon/></button>
          <a href="#plans" class="pill outline">Compare plans</a>
        </div>
      </div>
      <div class="hero-visual" data-hero-visual>
        <picture>
          <img src="assets/brand/hero-nurse.webp" srcset="assets/brand/hero-nurse.webp 1x, assets/brand/hero-nurse@2x.webp 2x" alt="A smiling BodyFactory nurse practitioner talks with a client during a consultation" fetchpriority="high" width="1314" height="883" />
        </picture>
        <ul class="hero-notes" aria-label="What your care includes">
          <li class="hero-note hero-card" style="--x:15%; --y:27%"><span class="hero-card-tag">Your first visit</span><ul><li>Health history and goals review</li><li>Clinical evaluation for eligibility</li><li>Clear pricing, shared upfront</li></ul></li>
          <li class="hero-note hero-chip" style="--x:76%; --y:32%"><i class="bi bi-calendar2-check" aria-hidden="true"></i>Regular check-ins</li>
          <li class="hero-note hero-chip" style="--x:73%; --y:81%"><i class="bi bi-person-heart" aria-hidden="true"></i>Personalized plans</li>
          <li class="hero-note hero-chip" style="--x:41%; --y:60%"><i class="bi bi-patch-check-fill" aria-hidden="true"></i>Licensed clinicians</li>
        </ul>
      </div>
    </section>

    <section class="approach container section" id="how" aria-labelledby="how-title">
      <h2 id="how-title" class="sr-only">How it works</h2>
      <p class="statement" data-highlight-words>GLP-1 and GIP therapies work with your body’s natural hormones to help control hunger, support your metabolism, and make lasting habits easier to keep.</p>
      <p class="supervision-line"><i class="bi bi-shield-check" aria-hidden="true"></i><span><strong>Medically supervised by a licensed prescribing nurse practitioner (NP).</strong> Medication is prescribed only when your NP confirms it is appropriate, and reviewed with you every month.</span></p>
    </section>

    <section class="why section container" aria-labelledby="why-title">
      <div class="section-head center" data-reveal><h2 id="why-title" class="t-h2">Why GLP-1 &amp; GIP?</h2><p class="t-lead">Two of the most advanced weight loss therapies available today, paired with close medical supervision by an NP.</p></div>
      <div class="benefit-orbit">
        <div class="orbit-left">{why.slice(0, 3).map(([icon, title, body]) => <article class="care-card"><i class:list={['bi', icon]} aria-hidden="true"></i><div><h3 class="t-h5">{title}</h3><p>{body}</p></div></article>)}</div>
        <div class="program-image-wrap" aria-hidden="true"><img src="assets/figma/vial.webp" alt="" loading="lazy" width="568" height="568"/></div>
        <div class="orbit-right">{why.slice(3).map(([icon, title, body]) => <article class="care-card"><i class:list={['bi', icon]} aria-hidden="true"></i><div><h3 class="t-h5">{title}</h3><p>{body}</p></div></article>)}</div>
      </div>
    </section>

    <section class="plans section" id="plans" aria-labelledby="plans-title">
      <div class="container">
        <div class="section-head" data-reveal><h2 id="plans-title" class="t-h2">Choose your membership.</h2><p class="t-lead">Two therapies, one standard of care. Your nurse practitioner confirms which, if either, is right for you.</p></div>
        <div class="plan-grid">
          {plans.map((plan, index) => (
            <article class:list={['plan', index === 1 && 'plan-dark']} id={plan.id} aria-labelledby={`${plan.id}-name`}>
              <header class="plan-head">
                <h3 id={`${plan.id}-name`} class="t-h3">{plan.name}</h3>
                <p class="plan-tier">{plan.tier}</p>
              </header>
              <p class="plan-price"><span class="plan-amount">${plan.price}</span><span>/month</span></p>
              <p class="plan-meds">{plan.meds}</p>
              <p class="plan-therapy"><strong>{plan.therapy}</strong> ({plan.ingredient})</p>
              <p class="plan-summary">{plan.summary}</p>
              <p class="plan-intro">{plan.intro}</p>
              <ul class="check-list">{plan.benefits.map(item => <li>{item}</li>)}</ul>
              <p class="plan-fit">{plan.fit}</p>
              <button class:list={['pill', index === 1 ? 'primary' : 'dark']} type="button" data-action="book">Start with {plan.name} <ArrowIcon/></button>
            </article>
          ))}
        </div>

        <div class="compare">
          <table>
            <caption class="t-h4">What each membership includes</caption>
            <thead><tr><th scope="col"><span class="sr-only">Included service</span></th><th scope="col">SlimFit™<span>$299/mo</span></th><th scope="col">SlimFit Plus™<span>$399/mo</span></th></tr></thead>
            <tbody>
              {inclusions.map(([label, a, b]) => (
                <tr data-row><th scope="row">{label}</th>{[a, b].map(on => <td>{on ? <><i class="bi bi-check-lg" aria-hidden="true"></i><span class="sr-only">Included</span></> : <><span class="dash" aria-hidden="true"></span><span class="sr-only">Not included</span></>}</td>)}</tr>
              ))}
            </tbody>
          </table>
          <p class="fine-print">{disclosure}</p>
        </div>
      </div>
    </section>

    <section class="process section" id="journey" aria-labelledby="journey-title">
      <div class="container process-grid">
        <div class="process-left">
          <h2 id="journey-title" class="t-h2" data-reveal>Your journey with BodyFactory.</h2>
          <img class="process-photo" src="assets/brand/journey-team.webp" srcset="assets/brand/journey-team.webp 1x, assets/brand/journey-team@2x.webp 2x" alt="Four members of the BodyFactory clinical team in branded scrubs" loading="lazy" width="498" height="579"/>
          <div class="process-intro"><p>Every step is explained before it happens, and your nurse practitioner stays with you from the first visit onward.</p><button class="pill primary" type="button" data-action="book">Schedule your consultation <ArrowIcon/></button></div>
        </div>
        <ol class="step-list" data-steps>
          {journey.map((step, index) => <li class="step-card"><span class="step-icon"><i class:list={['bi', step.icon]} aria-hidden="true"></i></span><div><span class="step-number" aria-hidden="true">{index + 1}</span><h3 class="t-h4">{step.title}</h3><p>{step.body}</p></div></li>)}
        </ol>
      </div>
    </section>

    <section class="care section" id="care" aria-labelledby="care-title" data-care>
      <div class="care-stage">
        <div class="container care-grid">
          <div class="care-intro">
            <h2 id="care-title" class="t-h2">Your care, month by month.</h2>
            <p class="t-lead">How your nurse practitioner evaluates, doses, and monitors your treatment.</p>
            <nav class="care-guide" aria-label="Care stages">
              <ol>
                {care.map((panel, index) => <li><a href={`#panel-${panel.id}`} data-care-step={index}><span class="care-guide-num">{String(index + 1).padStart(2, '0')}</span><span class="care-guide-label">{panel.tab}</span><span class="care-guide-bar" aria-hidden="true"><span></span></span></a></li>)}
              </ol>
              <p class="care-guide-current" data-care-current>{care[0].tab}</p>
            </nav>
          </div>
          <div class="care-panels">
            {care.map((panel, index) => (
              <article class="care-panel" id={`panel-${panel.id}`} aria-labelledby={`panel-${panel.id}-title`} data-care-panel={index}>
                <figure class="care-media">
                  <img src={panel.image.src} alt={panel.image.alt} loading="lazy" width="1200" height="800" style={`object-position:${panel.image.position}`} />
                </figure>
                <div class="care-body">
                  <p class="care-label"><span>{String(index + 1).padStart(2, '0')} / 04</span>{panel.tab}</p>
                  <h3 id={`panel-${panel.id}-title`} class="t-h3">{panel.title}</h3>
                  <p class="care-lead">{panel.intro}</p>
                  <ul class="check-list two-col">{panel.items.map(item => <li>{item}</li>)}</ul>
                  {panel.record && <div class="care-record"><h4 class="t-h6">Recorded at every monthly visit</h4><ul>{panel.record.map(item => <li>{item}</li>)}</ul></div>}
                  {panel.notes && <div class="care-notes">{panel.notes.map(([title, body]) => <p><strong>{title}</strong> {body}</p>)}</div>}
                  {panel.urgent && <p class="care-urgent" role="note"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><span>{panel.urgent}</span></p>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
      <p class="container fine-print care-fine">Your NP makes the final decision on medication selection, dosing, dose changes, and whether treatment continues. Compounded medications are prescribed and administered according to the specific formulation supplied by the compounding pharmacy.</p>
    </section>

    <section class="lifestyle section" aria-labelledby="lifestyle-title" data-lifestyle>
      <div class="container">
        <p class="eyebrow">Beyond the scale</p><h2 id="lifestyle-title" class="t-h2">A new lifestyle.</h2><p class="lifestyle-lead t-lead">Treatment may support more than weight loss. See what progress could mean for the life you live every day.</p>
        <div class="lifestyle-viewport" data-lifestyle-viewport>
          <div class="lifestyle-rail" data-lifestyle-rail role="region" aria-label="Potential wellness benefits">{benefits.map(([icon, title, body, image]) => <article class="life-card"><img src={image} alt="" loading="lazy" width="385" height="515"/><div class="life-card-shade"></div><span class="life-icon"><i class:list={['bi', icon]} aria-hidden="true"></i></span><div class="life-card-content"><h3 class="t-h4">{title}</h3><p>{body}</p></div></article>)}</div>
        </div>
      </div>
    </section>

    <section class="faq section container" id="faq" aria-labelledby="faq-title">
      <div class="faq-head"><h2 id="faq-title" class="t-h2" data-reveal>Frequently asked questions</h2><p>Still deciding? Bring any question to your consultation.</p><button class="pill outline" type="button" data-action="book">Ask the team</button></div>
      <div class="faq-list" data-faq>{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><span class="faq-symbol" aria-hidden="true"></span></summary><div class="faq-answer"><p>{answer}</p></div></details>)}</div>
    </section>


    <section class="locations section container" id="locations" aria-labelledby="locations-title">
      <div class="section-head" data-reveal><p class="eyebrow">Find us</p><h2 id="locations-title" class="t-h2">Three studios. One New York.</h2><p class="t-lead">Visit the BodyFactory studio that fits your city rhythm.</p></div>
      <div class="location-grid">{locations.map(location => <a class="location-card" href={location.url} target="_blank" rel="noopener noreferrer"><img src={location.image} alt="" loading="lazy"/><span class="location-shade"></span><span class="location-copy"><strong>{location.name}</strong><span>{location.address}</span></span><ArrowIcon class="location-arrow"/><span class="sr-only">, studio details, opens in a new tab</span></a>)}</div>
    </section>

    <section class="quick-test section" id="quick-test" aria-labelledby="test-title">
      <div class="container test-panel">
        <div class="test-copy"><h2 id="test-title" class="t-h3">Not sure where to start?</h2><p>Answer a few quick questions to receive a preliminary eligibility result. This is not a medical screening, but it will help indicate whether you're on the right path.</p><button class="pill primary" type="button" data-action="assessment">Check my eligibility <ArrowIcon/></button></div>
        <div class="test-preview"><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i><strong>Four quick steps.</strong><p>Measurements, health history, and safety questions, with your preliminary result at the end.</p></div>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-title" data-final-cta>
      <div class="container"><img src="assets/figma/vials.webp" alt="" loading="lazy" width="704" height="547"/><p class="eyebrow">Stronger. Healthier. Better you.</p><h2 id="final-title" class="t-display"><span>Your next <em>Self</em></span> <span>starts here.</span></h2><p class="t-lead">Medically guided. Science backed. Results driven.</p><button class="pill primary" type="button" data-action="book">Schedule your consultation <ArrowIcon/></button></div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-top">
        <div class="footer-about"><p>Personalized aesthetics and wellness care across New York City.</p></div>
        <nav aria-label="Footer navigation"><b>Explore</b>{nav.map(([href, label]) => <a href={href}>{label}</a>)}</nav>
        <div class="footer-contact"><b>Connect</b><a href={`mailto:${program.email}`}>{program.email}</a><div class="social-links"><a href="https://www.instagram.com/bodyfactoryskincare/" aria-label="BodyFactory on Instagram" target="_blank" rel="noopener noreferrer"><i class="bi bi-instagram" aria-hidden="true"></i></a><a href="https://www.tiktok.com/@bodyfactoryskincare" aria-label="BodyFactory on TikTok" target="_blank" rel="noopener noreferrer"><i class="bi bi-tiktok" aria-hidden="true"></i></a></div><a class="pill footer-home" href={program.home}>Visit BodyFactory</a></div>
      </div>
      <p class="footer-disclosure">{disclosure} This page is for general information and does not replace medical advice.</p>
      <a class="footer-brandmark" href={program.home} aria-label="Visit the BodyFactory Skin Care home page"><img src="assets/figma/footer-logo-huge.png" alt="" width="1160" height="372" loading="lazy"/></a>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} BodyFactory Skin Care. All rights reserved.</span><div><a href="https://www.bodyfactoryskincare.com/privacy-policy">Privacy</a><a href="https://www.bodyfactoryskincare.com/terms-and-conditions">Terms</a><a href="https://www.bodyfactoryskincare.com/disclaimer">HIPAA Disclaimer</a><a href="https://www.bodyfactoryskincare.com/accessibility">Accessibility</a><a href="https://www.bodyfactoryskincare.com/cookie-policy">Cookie Settings</a><a href="#top">Back to top</a></div></div>
    </div>
  </footer>

  <div class="sticky-cta" data-sticky-cta aria-hidden="true" inert>
    <p><strong>From $299</strong><span>/month</span></p>
    <button class="pill primary" type="button" data-action="book">Book consultation <ArrowIcon/></button>
  </div>

  <Dialogs/>
</Layout>
