---
/**
 * Reserved image slot. Keeps the final aspect ratio so swapping in the real
 * asset causes no layout shift. Briefs live in docs/image-briefs.md.
 */
interface Props { id: string; ratio?: string; label: string; class?: string }
const { id, ratio = '4 / 3', label, class: className = '' } = Astro.props;
---
<figure class:list={['image-placeholder', className]} style={`aspect-ratio:${ratio}`} data-image-slot={id} role="img" aria-label={`Image coming soon: ${label}`}>
  <i class="bi bi-image" aria-hidden="true"></i>
  <figcaption><strong>{id}</strong><span>{label}</span></figcaption>
</figure>
