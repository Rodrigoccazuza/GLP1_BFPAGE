---
import { program } from '../content';
import ArrowIcon from './ArrowIcon.astro';
---

<dialog id="booking-dialog" class="dialog booking-dialog" aria-labelledby="booking-title">
  <button class="dialog-close" data-close type="button" aria-label="Close consultation dialog"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
  <p class="eyebrow">Private consultation</p>
  <h2 id="booking-title">A conversation.<br/><em>A new beginning.</em></h2>
  <p>Speak with BodyFactory about GLP-1 care, available locations, and the details of your personalized program.</p>
  <div class="booking-note"><strong>Let’s find your next step.</strong><p>{program.bookingUrl ? 'Continue to BodyFactory scheduling to choose an available appointment.' : 'Our general booking page opens next. Please confirm GLP-1 consultation availability with the team before selecting a service.'}</p></div>
  <a href={program.bookingUrl || program.generalBookingUrl} class="action primary">Continue to booking <ArrowIcon/></a>
  <a class="text-link" href={`mailto:${program.email}?subject=GLP-1%20consultation%20inquiry`}>Email the team <ArrowIcon/></a>
  <small>Please keep medical details out of email. An appointment is confirmed only when BodyFactory confirms it.</small>
</dialog>

<dialog id="assessment-dialog" class="dialog assessment-dialog" aria-labelledby="assessment-title">
  <button class="dialog-close" data-close type="button" aria-label="Close assessment"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
  <div class="assessment-top"><span>YOUR FIRST STEP</span><span id="assessment-count">01 / 03</span></div>
  <progress id="assessment-progress" max="3" value="1" aria-label="Assessment progress"></progress>
  <h2 id="assessment-title" tabindex="-1">Let’s start<br/><em>with you.</em></h2>
  <p class="assessment-intro">Three questions to prepare for a consultation. This is not a medical screening. Your answers stay in this window and are cleared when you close it.</p>
  <form id="assessment-form" novalidate>
    <div id="assessment-question"></div>
    <p id="assessment-error" class="form-error" role="alert" hidden>Please choose an answer to continue.</p>
    <div class="assessment-controls">
      <button type="button" id="assessment-back" class="text-link" hidden>Back</button>
      <button type="submit" class="action primary" id="assessment-next">Continue <ArrowIcon/></button>
    </div>
  </form>
  <div id="assessment-result" hidden></div>
</dialog>
