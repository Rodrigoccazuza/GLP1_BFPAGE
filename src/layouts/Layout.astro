---
import '@fontsource/bodoni-moda/latin-400.css';
import '@fontsource/bodoni-moda/latin-400-italic.css';
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/work-sans/latin-400.css';
import '@fontsource/work-sans/latin-500.css';
import '@fontsource/work-sans/latin-600.css';
import '../styles/global.css';
const site = import.meta.env.PUBLIC_SITE_URL;
const canonical = site ? new URL('/', site).href : undefined;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>GLP-1 Medical Weight Management | BodyFactory NYC</title><meta name="description" content="Explore a personalized approach to medical weight management at BodyFactory. Learn about GLP-1 care and speak with a provider about your next step."/><meta name="theme-color" content="#3CBFB0"/>{canonical && <link rel="canonical" href={canonical}/>}<meta name="robots" content={import.meta.env.PUBLIC_LAUNCH_APPROVED === 'true' ? 'index,follow' : 'noindex,nofollow'}/><meta property="og:type" content="website"/><meta property="og:title" content="Weight loss. Backed by medicine. Built around you."/><meta property="og:description" content="A personalized approach to medical weight management. Unmistakably BodyFactory."/>{canonical && <><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/assets/glp1/hero/social.jpg', site).href}/></>}<meta name="twitter:card" content="summary_large_image"/><link rel="icon" href="/favicon.png"/></head><body><a class="skip-link" href="#main">Skip to content</a><slot/><script src="../scripts/interactions.ts"></script></body></html>
