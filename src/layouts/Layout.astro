---
import '@fontsource/bodoni-moda/latin-400.css';
import '@fontsource/bodoni-moda/latin-400-italic.css';
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/work-sans/latin-400.css';
import '@fontsource/work-sans/latin-500.css';
import '@fontsource/work-sans/latin-600.css';
import '../styles/figma.css';
const site = import.meta.env.PUBLIC_SITE_URL;
const canonical = site ? new URL('/', site).href : undefined;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>GLP-1 Medical Weight Management | BodyFactory NYC</title><meta name="description" content="Personalized GLP-1 weight management, prescribed when appropriate and administered in studio by our nursing team in New York City."/><meta name="theme-color" content="#3CBFB0"/>{canonical && <link rel="canonical" href={canonical}/>}<meta name="robots" content={import.meta.env.PUBLIC_LAUNCH_APPROVED === 'true' ? 'index,follow' : 'noindex,nofollow'}/><meta property="og:type" content="website"/><meta property="og:title" content="Feel like your real self again | BodyFactory"/><meta property="og:description" content="Personalized GLP-1 care, administered in studio in New York City."/>{canonical && <><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('assets/figma/hero.png', site).href}/></>}<meta name="twitter:card" content="summary_large_image"/><link rel="icon" href="favicon.png"/></head><body><a class="skip-link" href="#main">Skip to content</a><slot/><script src="../scripts/figma.ts"></script></body></html>
